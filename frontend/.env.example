# Base URL for the REST API. MUST include the /api/v1 prefix the backend
# mounts under (backend/app/api/routes.py: api_router = APIRouter(prefix="/api/v1")).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL for WebSocket connections. The backend mounts the WS route at
# the app root (backend/app/main.py: /ws/assessments/{assessment_id}), so no
# path prefix here — paths are appended by src/api/config.ts wsUrl().
VITE_WS_BASE_URL=ws://localhost:8000/ws