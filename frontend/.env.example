# Base URL for the REST API. MUST include the /api/v1 prefix the backend
# mounts under (backend/app/api/routes.py: api_router = APIRouter(prefix="/api/v1")).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL for WebSocket connections. NO `/ws` suffix here: the backend mounts
# its WS route at backend/app/main.py (/ws/assessments/{assessment_id}), and the
# `/ws` prefix is already part of the paths that src/api/ws.ts and
# src/components/LiveStatusPanel.tsx pass to wsUrl() in src/api/config.ts,
# which simply concatenates WS_BASE_URL + path.
# WARNING: adding a trailing `/ws` here duplicates the prefix and yields
# ws://localhost:8000/ws/ws/assessments/{id}, which fails the handshake (404).
VITE_WS_BASE_URL=ws://localhost:8000

# --- Same-origin alternative (dev only, behind a tunnel) -------------------
# Valid ONLY while the `vite dev` reverse proxy is in front (see
# vite.config.ts `server.proxy`). Use these when the Vite dev server is the
# single thing published through the Cloudflare tunnel: the browser then calls
# the API and the WebSocket on the same origin it loaded the page from, so no
# CORS allowlist is needed and the backend can stay private on 127.0.0.1:8000.
#
# VITE_API_BASE_URL=/api/v1
# VITE_WS_BASE_URL=/
#
# A relative WS base is resolved against the page origin by
# src/api/config.ts (https -> wss, otherwise ws). Do NOT use these values for a
# production build: `vite build` has no proxy, so VITE_API_BASE_URL /
# VITE_WS_BASE_URL must point at wherever the API is actually served from.
