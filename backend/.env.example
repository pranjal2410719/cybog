# Backend config — EXAMPLE TEMPLATE
# Copy to `.env` (untracked) and point the two paths at YOUR machine.
# Precedence: real environment variable > `.env` file > built-in default.
CYBOG_RUNTIME=development
CYBOG_CONFIG_PATH=../cybog/config.yaml
CYBOG_OUTPUT_ROOT=../cybog/reports
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
